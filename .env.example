# Segredo que assina o cookie de sessão (obrigatório em produção). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# PostgreSQL de produção (Neon). Sem ela, usa o PGlite local em .data/pglite.
DATABASE_URL=

# Número do WhatsApp do studio, só dígitos com DDI e DDD (ex.: 5519XXXXXXXXX).
NEXT_PUBLIC_WHATSAPP=

# Senha inicial dos usuários criados pelo "npm run seed".
SEED_SENHA=
